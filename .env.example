# Copy to .env and edit for your machine. Values here override config.py defaults.
# The translation LLM is any OpenAI-compatible Chat Completions backend, so you can
# switch provider by changing only these three values (LLM_BASE_URL/MODEL/API_KEY).
#
# Example base URLs (pick one; it MUST end in the provider's /v1 path):
#   Local LM Studio                 http://localhost:1234/v1
#   Remote LM Studio (LAN)          http://192.168.88.111:1234/v1
#   Ollama                          http://localhost:11434/v1
#   OpenAI                          https://api.openai.com/v1
#   Mistral                         https://api.mistral.ai/v1
#   Google (OpenAI-compat)          https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic (OpenAI-compat)       https://api.anthropic.com/v1
# Set LLM_API_KEY for cloud providers; leave it empty for a local LM Studio / Ollama.

LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-31b
LLM_API_KEY=

# Optional overrides:
# ROFORMER_MODEL=model_bs_roformer_ep_317_sdr_12.9755.ckpt
# LLM_WEIGHTS_GB=19.0     # local-LLM VRAM estimate, only used to size local context
